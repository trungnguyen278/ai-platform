{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The app API, ai-app and ai-cloud, version 1.4",
  "description": "Every request and response body of protocols/app/README.md. Validate the app's against #/$defs/from_app, the cloud's against #/$defs/from_cloud. The OAuth endpoints' form fields are written as a JSON object. Unknown fields are allowed, so that newer minor versions can add them.",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "instant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "RFC 3339, in UTC"
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
      "maxLength": 35,
      "description": "A BCP 47 tag"
    },
    "languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/language"
      },
      "maxItems": 10,
      "uniqueItems": true,
      "description": "Most preferred first (ADR-0002)"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254,
      "pattern": "^[^@\u0000- \u007f-   -     　﻿]+@[^@\u0000- \u007f-   -     　﻿]+$",
      "description": "Something, @, then something, with no control character, space or separator, as any engine reads them (ADR-0010)"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "description": "An ID, access or refresh token: opaque to the app, except the ID token, which the provider made"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "32 random bytes, base64url without padding"
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "google or apple; development in the development environment. Others may come with later versions."
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "authorization_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "Sign in with Apple's authorization code, which comes with Apple's ID token only"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\u0000-\u001f\u007f-\u009f]+$",
      "description": "A name that a request sets: without control characters"
    },
    "time_zone": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$",
      "maxLength": 64,
      "description": "An IANA time zone name (ADR-0004)"
    },
    "home_languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/language"
      },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "description": "A home's default languages, most preferred first (ADR-0002, ADR-0005)"
    },
    "etag": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "owner, admin or member. Others may come with later versions: the app treats one it does not know as member."
    },
    "member_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "account or profile. Others may come with later versions: the app treats one it does not know as profile."
    },
    "invitation_code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "32 random bytes, base64url without padding"
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "description": "A challenge to register a device: 32 random bytes, base64url without padding"
    },
    "device_kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "robot, or another kind of device: the app shows one it does not know as a device"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "description": "A device's model, as its maker names it"
    },
    "token_exchange_request": {
      "description": "Form fields of POST /app/token, exchanging a provider's ID token (README, The exchange)",
      "type": "object",
      "required": [
        "grant_type",
        "subject_token",
        "subject_token_type",
        "client_id"
      ],
      "properties": {
        "grant_type": {
          "const": "urn:ietf:params:oauth:grant-type:token-exchange"
        },
        "subject_token": {
          "$ref": "#/$defs/token"
        },
        "subject_token_type": {
          "const": "urn:ietf:params:oauth:token-type:id_token"
        },
        "client_id": {
          "$ref": "#/$defs/client_id"
        },
        "session_label": {
          "type": "string",
          "maxLength": 100
        },
        "authorization_code": {
          "$ref": "#/$defs/authorization_code"
        }
      }
    },
    "refresh_request": {
      "description": "Form fields of POST /app/token, refreshing (README, Refreshing)",
      "type": "object",
      "required": [
        "grant_type",
        "refresh_token",
        "client_id"
      ],
      "properties": {
        "grant_type": {
          "const": "refresh_token"
        },
        "refresh_token": {
          "$ref": "#/$defs/token"
        },
        "client_id": {
          "$ref": "#/$defs/client_id"
        }
      }
    },
    "revoke_request": {
      "description": "Form fields of POST /app/revoke (README, Signing out)",
      "type": "object",
      "required": [
        "token",
        "client_id"
      ],
      "properties": {
        "token": {
          "$ref": "#/$defs/token"
        },
        "token_type_hint": {
          "enum": [
            "refresh_token",
            "access_token"
          ]
        },
        "client_id": {
          "$ref": "#/$defs/client_id"
        }
      }
    },
    "account_update": {
      "description": "PATCH /app/v1/account: the fields to change (README, Changing it)",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "display_name": {
          "$ref": "#/$defs/display_name"
        },
        "languages": {
          "$ref": "#/$defs/languages"
        }
      }
    },
    "id_token_request": {
      "description": "An ID token just signed in: to link an identity (POST /app/v1/account/identities), to delete the account (POST /app/v1/account:delete), or to delete a home (POST /app/v1/homes/{home_id}:delete). README, Identities, Deleting it and Deleting a home",
      "type": "object",
      "required": [
        "id_token"
      ],
      "properties": {
        "id_token": {
          "$ref": "#/$defs/token"
        },
        "authorization_code": {
          "$ref": "#/$defs/authorization_code"
        }
      }
    },
    "home_create": {
      "description": "POST /app/v1/homes (README, Creating a home)",
      "type": "object",
      "required": [
        "name",
        "time_zone",
        "languages"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "time_zone": {
          "$ref": "#/$defs/time_zone"
        },
        "languages": {
          "$ref": "#/$defs/home_languages"
        }
      }
    },
    "home_update": {
      "description": "PATCH /app/v1/homes/{home_id}: the fields to change (README, Reading and changing a home)",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "time_zone": {
          "$ref": "#/$defs/time_zone"
        },
        "languages": {
          "$ref": "#/$defs/home_languages"
        }
      }
    },
    "profile_create": {
      "description": "POST /app/v1/homes/{home_id}/members: a profile (README, The people in a home)",
      "type": "object",
      "required": [
        "display_name"
      ],
      "properties": {
        "display_name": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "member_update": {
      "description": "PATCH /app/v1/homes/{home_id}/members/{member_id}: the fields to change (README, The people in a home)",
      "type": "object",
      "minProperties": 1,
      "properties": {
        "role": {
          "enum": [
            "admin",
            "member"
          ]
        },
        "display_name": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "invitation_code_request": {
      "description": "POST /app/v1/invitations:lookup and POST /app/v1/invitations:accept (README, Invitations)",
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/invitation_code"
        }
      }
    },
    "home_transfer": {
      "description": "POST /app/v1/homes/{home_id}:transfer, with an ID token just signed in (README, Handing a home over)",
      "type": "object",
      "required": [
        "to_member_id",
        "id_token"
      ],
      "properties": {
        "to_member_id": {
          "$ref": "#/$defs/uuid"
        },
        "id_token": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "device_registration": {
      "description": "POST /app/v1/homes/{home_id}/devices: the registration that the device signed at set-up (README, Adding a device)",
      "type": "object",
      "required": [
        "registration"
      ],
      "properties": {
        "registration": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
          "maxLength": 4096,
          "description": "A JWT, as set-up's registration answer carries it (protocols/setup/README.md, The registration)"
        }
      }
    },
    "development_id_token_request": {
      "description": "POST /app/v1/development/id-tokens, in the development environment only (README, Development)",
      "type": "object",
      "required": [
        "nonce",
        "display_name"
      ],
      "properties": {
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "display_name": {
          "$ref": "#/$defs/display_name"
        },
        "email": {
          "$ref": "#/$defs/email"
        }
      }
    },
    "nonce_response": {
      "description": "What POST /app/v1/nonces answers (README, The nonce)",
      "type": "object",
      "required": [
        "nonce",
        "expires_in"
      ],
      "properties": {
        "nonce": {
          "$ref": "#/$defs/nonce"
        },
        "expires_in": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "description": "Seconds"
        }
      }
    },
    "token_response": {
      "description": "What POST /app/token answers to an exchange or a refresh (README, The exchange)",
      "type": "object",
      "required": [
        "access_token",
        "token_type",
        "expires_in",
        "refresh_token"
      ],
      "properties": {
        "access_token": {
          "$ref": "#/$defs/token"
        },
        "issued_token_type": {
          "const": "urn:ietf:params:oauth:token-type:access_token",
          "description": "In the answer to an exchange (RFC 8693)"
        },
        "token_type": {
          "type": "string",
          "pattern": "^[Bb][Ee][Aa][Rr][Ee][Rr]$",
          "description": "Bearer, in any case (RFC 6749)"
        },
        "expires_in": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "description": "Seconds"
        },
        "refresh_token": {
          "$ref": "#/$defs/token"
        }
      }
    },
    "oauth_error": {
      "description": "What the OAuth endpoints answer to a request they refuse (README, Errors)",
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "#/$defs/code",
          "description": "invalid_request, invalid_client, invalid_grant or unsupported_grant_type"
        },
        "error_description": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "identity": {
      "description": "A way to sign in to an account (README, The account)",
      "type": "object",
      "required": [
        "id",
        "provider",
        "create_time"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "email": {
          "$ref": "#/$defs/email"
        },
        "create_time": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "account": {
      "description": "What GET and PATCH /app/v1/account answer (README, The account)",
      "type": "object",
      "required": [
        "id",
        "display_name",
        "languages",
        "identities",
        "create_time",
        "etag"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "display_name": {
          "$ref": "#/$defs/display_name"
        },
        "email": {
          "$ref": "#/$defs/email"
        },
        "languages": {
          "$ref": "#/$defs/languages"
        },
        "identities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identity"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "create_time": {
          "$ref": "#/$defs/instant"
        },
        "etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "session": {
      "description": "One app, on one phone, signed in (README, Sessions)",
      "type": "object",
      "required": [
        "id",
        "create_time",
        "last_use_time",
        "current"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "create_time": {
          "$ref": "#/$defs/instant"
        },
        "last_use_time": {
          "$ref": "#/$defs/instant"
        },
        "current": {
          "type": "boolean"
        }
      }
    },
    "session_list": {
      "description": "What GET /app/v1/account/sessions answers: a page (README, Sessions)",
      "type": "object",
      "required": [
        "sessions",
        "next_page_token"
      ],
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          },
          "maxItems": 50
        },
        "next_page_token": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "home": {
      "description": "What creating, reading and changing a home answer (README, Homes). member_id and role are those of the person who asks.",
      "type": "object",
      "required": [
        "id",
        "name",
        "time_zone",
        "languages",
        "member_id",
        "role",
        "create_time",
        "etag"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "time_zone": {
          "$ref": "#/$defs/time_zone"
        },
        "languages": {
          "$ref": "#/$defs/home_languages"
        },
        "member_id": {
          "$ref": "#/$defs/uuid"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "create_time": {
          "$ref": "#/$defs/instant"
        },
        "etag": {
          "$ref": "#/$defs/etag"
        }
      }
    },
    "home_list": {
      "description": "What GET /app/v1/homes answers: a page (README, Reading and changing a home)",
      "type": "object",
      "required": [
        "homes",
        "next_page_token"
      ],
      "properties": {
        "homes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/home"
          },
          "maxItems": 50
        },
        "next_page_token": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "member": {
      "description": "A person in a home (README, The people in a home). A person with an account has a role; a profile has none.",
      "type": "object",
      "required": [
        "id",
        "kind",
        "display_name",
        "current",
        "create_time",
        "etag"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "$ref": "#/$defs/member_kind"
        },
        "display_name": {
          "$ref": "#/$defs/display_name"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "current": {
          "type": "boolean"
        },
        "create_time": {
          "$ref": "#/$defs/instant"
        },
        "etag": {
          "$ref": "#/$defs/etag"
        }
      },
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "account"
          }
        }
      },
      "then": {
        "required": [
          "role"
        ]
      }
    },
    "member_list": {
      "description": "What GET /app/v1/homes/{home_id}/members answers: a page (README, The people in a home)",
      "type": "object",
      "required": [
        "members",
        "next_page_token"
      ],
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "maxItems": 50
        },
        "next_page_token": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "invitation": {
      "description": "An open invitation. Its code comes only in the answer that makes it (README, Invitations)",
      "type": "object",
      "required": [
        "id",
        "invited_by",
        "create_time",
        "expire_time"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "code": {
          "$ref": "#/$defs/invitation_code"
        },
        "invited_by": {
          "$ref": "#/$defs/display_name"
        },
        "create_time": {
          "$ref": "#/$defs/instant"
        },
        "expire_time": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "invitation_list": {
      "description": "What GET /app/v1/homes/{home_id}/invitations answers: a page, without codes (README, Invitations)",
      "type": "object",
      "required": [
        "invitations",
        "next_page_token"
      ],
      "properties": {
        "invitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invitation"
          },
          "maxItems": 50
        },
        "next_page_token": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "invitation_preview": {
      "description": "What POST /app/v1/invitations:lookup answers (README, Invitations)",
      "type": "object",
      "required": [
        "home_name",
        "invited_by",
        "expire_time"
      ],
      "properties": {
        "home_name": {
          "$ref": "#/$defs/name"
        },
        "invited_by": {
          "$ref": "#/$defs/display_name"
        },
        "expire_time": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "device_challenge": {
      "description": "What POST /app/v1/homes/{home_id}/device-challenges answers (README, Adding a device)",
      "type": "object",
      "required": [
        "challenge",
        "server",
        "expires_in"
      ],
      "properties": {
        "challenge": {
          "$ref": "#/$defs/challenge"
        },
        "server": {
          "type": "string",
          "pattern": "^https?://",
          "maxLength": 2048,
          "description": "The address that devices use, which the app gives the device in set-up's register"
        },
        "expires_in": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600,
          "description": "Seconds"
        }
      }
    },
    "device": {
      "description": "A device in a home (README, Devices). kind, model and software come with its first session on the cloud link.",
      "type": "object",
      "required": [
        "id",
        "connected",
        "create_time"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "kind": {
          "$ref": "#/$defs/device_kind"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "software": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "connected": {
          "type": "boolean",
          "description": "Whether its control channel is open now"
        },
        "create_time": {
          "$ref": "#/$defs/instant"
        }
      }
    },
    "device_list": {
      "description": "What GET /app/v1/homes/{home_id}/devices answers: a page (README, Devices)",
      "type": "object",
      "required": [
        "devices",
        "next_page_token"
      ],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/device"
          },
          "maxItems": 50
        },
        "next_page_token": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "problem": {
      "description": "Problem Details (RFC 9457), as the API answers an error (README, Errors)",
      "type": "object",
      "required": [
        "type",
        "title",
        "status"
      ],
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^(about:blank|/app/v[0-9]+/problems/[a-z][a-z0-9_]{0,63})$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
